limit_req_zone $binary_remote_addr zone=ask_limit:10m rate=30r/m;

server {
    listen 80;
    server_name __DOMAIN__;
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location = /health {
        include /etc/nginx/includes/proxy.inc;
    }
    location / {
        return 308 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;
    server_tokens off;
    client_max_body_size 32k;
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate /etc/letsencrypt/live/oa-demo/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oa-demo/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;

    auth_basic "OA Demo";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /health {
        auth_basic off;
        include /etc/nginx/includes/proxy.inc;
    }
    location = /ask {
        limit_req zone=ask_limit burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/includes/proxy.inc;
    }
    location = /docs {
        include /etc/nginx/includes/proxy.inc;
    }
    location = /openapi.json {
        include /etc/nginx/includes/proxy.inc;
    }
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
